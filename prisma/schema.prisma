// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  id                 String   @id @unique
  fullName           String
  christianName      String
  gender             String
  educationLevel     String
  dob                DateTime
  subcity            String
  kebele             String
  houseNumber        String
  houseAddressDetail String
  phone              String
  additionalPhone    String?
  fatherPhone        String?
  motherName         String?
  motherPhone        String?
  joiningDate        DateTime
  formFilledDate     DateTime
  role               Role
  photoUrl           String?
}

model AdminCredential {
  role     UserRole @id @unique
  password String
}

enum Role {
  children
  children2
  juniors
  seniors
  youth
}

enum UserRole {
  children
  children2
  juniors
  seniors
  superadmin
}
