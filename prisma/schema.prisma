// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  id                 String    @id
  fullName           String
  christianName      String
  gender             String // Represents 'ወንድ' or 'ሴት'
  educationLevel     String
  dob                DateTime
  subcity            String
  kebele             String
  houseNumber        String
  houseAddressDetail String    @db.Text
  phone              String
  additionalPhone    String?
  fatherPhone        String?
  motherName         String?
  motherPhone        String?
  joiningDate        DateTime
  formFilledDate     DateTime
  role               String // Represents Role: 'children', 'children2', 'juniors', 'seniors', 'youth'
  photoUrl           String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
