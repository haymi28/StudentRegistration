
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  id                 String   @id
  fullName           String
  christianName      String
  gender             String
  educationLevel     String
  dob                DateTime
  subcity            String
  kebele             String
  houseNumber        String
  houseAddressDetail String
  phone              String
  additionalPhone    String?
  fatherPhone        String?
  motherName         String?
  motherPhone        String?
  joiningDate        DateTime
  formFilledDate     DateTime
  photoUrl           String?
  role               String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AdminCredential {
  id        String   @id @default(cuid())
  role      String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
