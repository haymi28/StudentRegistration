// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  id                 String    @id
  fullName           String
  christianName      String
  gender             String
  educationLevel     String
  dob                DateTime
  subcity            String
  kebele             String
  houseNumber        String
  houseAddressDetail String
  phone              String
  additionalPhone    String?
  fatherPhone        String?
  motherName         String?
  motherPhone        String?
  joiningDate        DateTime
  role               Role
  photoUrl           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

enum Role {
  children
  children2
  juniors
  seniors
}
