// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  id                 String   @id
  fullName           String
  christianName      String
  gender             String
  educationLevel     String
  dob                DateTime
  subcity            String
  kebele             String
  houseNumber        String
  houseAddressDetail String
  phone              String
  additionalPhone    String?
  fatherPhone        String?
  motherPhone        String?
  joiningDate        DateTime
  role               Role
  photoUrl           String?
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // In a real app, this should be a hash
  role      UserRole
  createdAt DateTime @default(now())
}

enum Role {
  children
  children2
  juniors
  seniors
}

enum UserRole {
  superadmin
  children
  children2
  juniors
  seniors
}
