// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Student {
  id                  String    @id @unique
  fullName            String
  christianName       String
  motherName          String?
  gender              String
  educationLevel      String
  dob                 DateTime
  subcity             String
  kebele              String
  houseNumber         String
  houseAddressDetail  String
  phone               String
  additionalPhone     String?
  fatherPhone         String?
  motherPhone         String?
  joiningDate         DateTime
  formFilledDate      DateTime
  role                Role
  photoUrl            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

enum Role {
  children
  children2
  juniors
  seniors
}
